<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>时间管理能力测评 | Time Management Behaviors Scale</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter & Noto Sans SC -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- QRCode.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', '"Noto Sans SC"', 'system-ui', 'sans-serif'],
          },
          colors: {
            morandi: {
              50: '#F4F7F9',
              100: '#E5ECF0',
              200: '#CAD9E2',
              300: '#A4BECD',
              400: '#7C9EB2',
              500: '#6B8E9B', // Primary Morandi Light Blue
              600: '#4A6B82', // Primary Morandi Deep Blue
              700: '#3B5669',
              800: '#324857',
              900: '#2B3C49',
            },
            warmwhite: '#FAF9F6',
            sand: '#EFECE6'
          },
          boxShadow: {
            'soft': '0 10px 30px -5px rgba(74, 107, 130, 0.08)',
            'card': '0 4px 20px -2px rgba(74, 107, 130, 0.06)',
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #F4F7F9;
      color: #2B3C49;
      -webkit-tap-highlight-color: transparent;
    }
    /* Custom Radio Pill Transitions */
    .likert-btn {
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .likert-btn:active {
      transform: scale(0.95);
    }
    .fade-in {
      animation: fadeIn 0.35s ease-out forwards;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #F4F7F9;
    }
    ::-webkit-scrollbar-thumb {
      background: #CAD9E2;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #7C9EB2;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-morandi-200 selection:text-morandi-900">

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 pointer-events-none w-[90%] max-w-md"></div>

  <!-- Top Navigation Header -->
  <header class="sticky top-0 z-30 bg-white/85 backdrop-blur-md border-b border-morandi-100">
    <div class="max-w-4xl mx-auto px-4 h-16 flex items-center justify-between">
      <div class="flex items-center gap-2.5 cursor-pointer" onclick="switchView('assessment')">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-morandi-600 to-morandi-500 flex items-center justify-center text-white shadow-sm">
          <i data-lucide="clock" class="w-5 h-5"></i>
        </div>
        <div>
          <h1 class="font-bold text-base sm:text-lg text-morandi-900 leading-tight">时间管理能力测评</h1>
          <p class="text-[11px] text-morandi-500 hidden sm:block">Time Management Behaviors Scale (TMBS)</p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <!-- My Report Button (Visible if completed) -->
        <button id="nav-report-btn" onclick="switchView('report')" class="hidden items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-medium text-morandi-600 bg-morandi-50 hover:bg-morandi-100 transition">
          <i data-lucide="file-bar-chart-2" class="w-4 h-4"></i>
          <span>我的报告</span>
        </button>

        <!-- Share QR Code Button -->
        <button onclick="openQrModal()" class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-medium text-morandi-700 bg-morandi-100/80 hover:bg-morandi-200/80 transition">
          <i data-lucide="qr-code" class="w-4 h-4 text-morandi-600"></i>
          <span>分享二维码</span>
        </button>

        <!-- Admin Dashboard Button -->
        <button onclick="handleAdminNav()" class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs sm:text-sm font-medium text-white bg-morandi-600 hover:bg-morandi-700 shadow-sm transition">
          <i data-lucide="bar-chart-3" class="w-4 h-4"></i>
          <span class="hidden xs:inline">汇总看板</span>
          <span class="xs:hidden">汇总</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="flex-1 max-w-4xl w-full mx-auto px-4 py-6 sm:py-8">

    <!-- ==================== VIEW 1: PARTICIPANT ASSESSMENT ==================== -->
    <section id="view-assessment" class="fade-in space-y-6">
      <!-- Welcome & Participant Info Card -->
      <div class="bg-warmwhite rounded-3xl p-6 sm:p-8 shadow-soft border border-morandi-100 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-40 h-40 bg-gradient-to-bl from-morandi-200/40 to-transparent rounded-bl-full pointer-events-none"></div>
        <div class="relative">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-morandi-100 text-morandi-700 text-xs font-medium mb-3">
            <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
            <span>学术经典量表 · 预计耗时 3 分钟</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-morandi-900 mb-2">探索你的时间掌控力</h2>
          <p class="text-sm text-morandi-700/85 leading-relaxed mb-6">
            本测评基于 Macan 等人编制的《时间管理行为量表》(TMBS)，从<strong>目标与优先级设定</strong>、<strong>计划与日程执行</strong>、<strong>条理性与环境偏好</strong>三大核心维度全面评估你的时间管理风格，提交后立即生成专属可视化分析报告。
          </p>

          <!-- Participant Identity Inputs -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-white p-4 rounded-2xl border border-morandi-100">
            <div>
              <label for="input-name" class="block text-xs font-semibold text-morandi-700 mb-1.5">
                姓名 / 昵称 <span class="text-rose-500">*</span>
              </label>
              <div class="relative">
                <i data-lucide="user" class="w-4 h-4 text-morandi-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                <input type="text" id="input-name" placeholder="请输入您的姓名或昵称"
                  class="w-full pl-10 pr-4 py-2.5 bg-morandi-50/60 border border-morandi-200 rounded-xl text-sm text-morandi-900 placeholder-morandi-400 focus:outline-none focus:border-morandi-500 focus:bg-white transition" />
              </div>
            </div>
            <div>
              <label for="input-group" class="block text-xs font-semibold text-morandi-700 mb-1.5">
                组别 / 部门 / 学号 <span class="text-morandi-400 font-normal">(选填，便于汇总统计)</span>
              </label>
              <div class="relative">
                <i data-lucide="tag" class="w-4 h-4 text-morandi-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                <input type="text" id="input-group" placeholder="例如：产品组 / 2026级1班"
                  class="w-full pl-10 pr-4 py-2.5 bg-morandi-50/60 border border-morandi-200 rounded-xl text-sm text-morandi-900 placeholder-morandi-400 focus:outline-none focus:border-morandi-500 focus:bg-white transition" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Sticky Progress & Mode Control Bar -->
      <div class="sticky top-16 z-20 bg-morandi-50/95 backdrop-blur-md py-3 border-b border-morandi-200/60">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-morandi-800">答题进度</span>
            <span id="progress-text" class="text-xs font-bold text-morandi-600 bg-white px-2.5 py-0.5 rounded-full border border-morandi-200">0 / 28 题</span>
          </div>
          <!-- View Mode Switcher: Step-by-step vs All at once -->
          <div class="inline-flex bg-morandi-200/60 p-0.5 rounded-xl text-xs">
            <button id="mode-step-btn" onclick="setQuestionMode('step')" class="px-3 py-1 rounded-lg font-medium bg-white text-morandi-800 shadow-sm transition">
              分维度答题
            </button>
            <button id="mode-all-btn" onclick="setQuestionMode('all')" class="px-3 py-1 rounded-lg font-medium text-morandi-600 hover:text-morandi-900 transition">
              全览模式
            </button>
          </div>
        </div>
        <!-- Progress Bar -->
        <div class="w-full h-2 bg-morandi-200/70 rounded-full overflow-hidden">
          <div id="progress-bar" class="h-full bg-gradient-to-r from-morandi-500 to-morandi-600 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
        <!-- Dimension Tabs (Visible in Step Mode) -->
        <div id="dimension-tabs" class="grid grid-cols-3 gap-2 mt-3">
          <button onclick="setActiveStep(0)" id="step-tab-0" class="py-2 px-2 rounded-xl text-xs font-semibold border transition flex flex-col sm:flex-row items-center justify-center gap-1 bg-morandi-600 text-white border-morandi-600 shadow-sm">
            <span>一、目标设定</span>
            <span id="step-count-0" class="opacity-80 text-[11px]">(0/10)</span>
          </button>
          <button onclick="setActiveStep(1)" id="step-tab-1" class="py-2 px-2 rounded-xl text-xs font-semibold border transition flex flex-col sm:flex-row items-center justify-center gap-1 bg-white text-morandi-600 border-morandi-200 hover:bg-morandi-100/50">
            <span>二、计划执行</span>
            <span id="step-count-1" class="opacity-80 text-[11px]">(0/11)</span>
          </button>
          <button onclick="setActiveStep(2)" id="step-tab-2" class="py-2 px-2 rounded-xl text-xs font-semibold border transition flex flex-col sm:flex-row items-center justify-center gap-1 bg-white text-morandi-600 border-morandi-200 hover:bg-morandi-100/50">
            <span>三、条理偏好</span>
            <span id="step-count-2" class="opacity-80 text-[11px]">(0/7)</span>
          </button>
        </div>
      </div>

      <!-- Scale Legend Hint -->
      <div class="bg-white/80 rounded-2xl px-4 py-3 border border-morandi-100 flex flex-wrap items-center justify-between gap-2 text-xs text-morandi-600">
        <span class="font-medium text-morandi-800">计分标准：</span>
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          <span><strong>1</strong> = 非常不符合</span>
          <span><strong>2</strong> = 不太符合</span>
          <span><strong>3</strong> = 一般</span>
          <span><strong>4</strong> = 比较符合</span>
          <span><strong>5</strong> = 非常符合</span>
        </div>
      </div>

      <!-- Questions Container -->
      <div id="questions-container" class="space-y-4"></div>

      <!-- Bottom Navigation & Submit Controls -->
      <div class="pt-4 pb-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div id="step-nav-buttons" class="flex items-center gap-3 w-full sm:w-auto">
          <button id="prev-step-btn" onclick="changeStep(-1)" class="flex-1 sm:flex-none px-5 py-3 rounded-2xl font-semibold text-sm bg-white text-morandi-700 border border-morandi-200 hover:bg-morandi-100 transition disabled:opacity-40 disabled:pointer-events-none">
            ← 上一维度
          </button>
          <button id="next-step-btn" onclick="changeStep(1)" class="flex-1 sm:flex-none px-5 py-3 rounded-2xl font-semibold text-sm bg-morandi-100 text-morandi-800 hover:bg-morandi-200 transition">
            下一维度 →
          </button>
        </div>

        <button id="submit-btn" onclick="submitAssessment()" class="w-full sm:w-auto sm:ml-auto px-8 py-3.5 rounded-2xl font-bold text-sm text-white bg-gradient-to-r from-morandi-600 to-morandi-500 hover:from-morandi-700 hover:to-morandi-600 shadow-lg shadow-morandi-600/20 transition flex items-center justify-center gap-2">
          <i data-lucide="check-circle-2" class="w-5 h-5"></i>
          <span>提交并生成分析报告</span>
        </button>
      </div>
    </section>

    <!-- ==================== VIEW 2: INSTANT ANALYSIS REPORT ==================== -->
    <section id="view-report" class="hidden fade-in space-y-6 pb-10">
      <!-- Report Action Header -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        <button onclick="startNewAssessment()" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs sm:text-sm font-medium bg-white text-morandi-700 border border-morandi-200 hover:bg-morandi-50 transition">
          <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
          <span>重新测评 / 下一位填写</span>
        </button>
        <div class="flex items-center gap-2">
          <span id="sync-badge" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
            <i data-lucide="cloud-check" class="w-3.5 h-3.5"></i>
            <span>结果已自动同步汇总</span>
          </span>
        </div>
      </div>

      <!-- Main Score & Tier Result Card -->
      <div id="report-capture-area" class="bg-warmwhite rounded-3xl p-6 sm:p-8 shadow-soft border border-morandi-100 space-y-6">
        <!-- User Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-morandi-100 pb-5">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs font-semibold uppercase tracking-wider text-morandi-500">TMBS 时间管理能力诊断书</span>
            </div>
            <h2 class="text-2xl font-bold text-morandi-900">
              <span id="rep-name">测评者</span>
              <span id="rep-group" class="ml-2 text-sm font-normal text-morandi-500"></span>
            </h2>
            <p id="rep-time" class="text-xs text-morandi-400 mt-1"></p>
          </div>

          <!-- Tier Badge -->
          <div id="rep-tier-badge" class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-morandi-600 text-white shadow-sm self-start sm:self-center">
            <i id="rep-tier-icon" data-lucide="award" class="w-6 h-6"></i>
            <div>
              <div class="text-[10px] opacity-80 leading-none mb-0.5">综合能力等级</div>
              <div id="rep-tier-title" class="text-base font-bold leading-tight">卓越掌控型</div>
            </div>
          </div>
        </div>

        <!-- Score Summary & Radar Chart Grid -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
          <!-- Left: Big Score + Dimension Bars -->
          <div class="md:col-span-6 space-y-5">
            <div class="bg-white rounded-2xl p-5 border border-morandi-100 flex items-center justify-between">
              <div>
                <div class="text-xs font-medium text-morandi-500 mb-1">综合总分 (满分 140 分)</div>
                <div class="flex items-baseline gap-2">
                  <span id="rep-total-score" class="text-4xl font-extrabold text-morandi-700">118</span>
                  <span class="text-sm text-morandi-400">/ 140</span>
                </div>
              </div>
              <div class="h-12 w-[1px] bg-morandi-100"></div>
              <div class="text-right">
                <div class="text-xs font-medium text-morandi-500 mb-1">题项平均分 (1.0 - 5.0)</div>
                <div class="flex items-baseline justify-end gap-1">
                  <span id="rep-avg-score" class="text-3xl font-bold text-morandi-600">4.21</span>
                  <span class="text-xs text-morandi-400">分</span>
                </div>
              </div>
            </div>

            <!-- 3 Dimensions Horizontal Comparison Bars -->
            <div class="bg-white rounded-2xl p-5 border border-morandi-100 space-y-4">
              <h3 class="text-xs font-bold text-morandi-800 uppercase tracking-wider">三大核心维度得分表现</h3>
              
              <!-- Dim 1 -->
              <div>
                <div class="flex justify-between text-xs mb-1.5">
                  <span class="font-semibold text-morandi-800">1. 目标与优先级设定</span>
                  <span class="font-bold text-morandi-600"><span id="rep-d1-score">0</span>/50 (<span id="rep-d1-pct">0</span>%)</span>
                </div>
                <div class="w-full h-2.5 bg-morandi-100 rounded-full overflow-hidden">
                  <div id="rep-d1-bar" class="h-full bg-morandi-600 rounded-full transition-all duration-700" style="width: 0%"></div>
                </div>
              </div>

              <!-- Dim 2 -->
              <div>
                <div class="flex justify-between text-xs mb-1.5">
                  <span class="font-semibold text-morandi-800">2. 计划与日程执行技巧</span>
                  <span class="font-bold text-morandi-500"><span id="rep-d2-score">0</span>/55 (<span id="rep-d2-pct">0</span>%)</span>
                </div>
                <div class="w-full h-2.5 bg-morandi-100 rounded-full overflow-hidden">
                  <div id="rep-d2-bar" class="h-full bg-morandi-500 rounded-full transition-all duration-700" style="width: 0%"></div>
                </div>
              </div>

              <!-- Dim 3 -->
              <div>
                <div class="flex justify-between text-xs mb-1.5">
                  <span class="font-semibold text-morandi-800">3. 条理性与环境偏好</span>
                  <span class="font-bold text-teal-600"><span id="rep-d3-score">0</span>/35 (<span id="rep-d3-pct">0</span>%)</span>
                </div>
                <div class="w-full h-2.5 bg-morandi-100 rounded-full overflow-hidden">
                  <div id="rep-d3-bar" class="h-full bg-teal-600/80 rounded-full transition-all duration-700" style="width: 0%"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: SVG 3-Axis Radar Chart -->
          <div class="md:col-span-6 bg-white rounded-2xl p-4 border border-morandi-100 flex flex-col items-center justify-center">
            <h3 class="text-xs font-bold text-morandi-800 mb-1">三维度能力雷达图</h3>
            <p class="text-[11px] text-morandi-400 mb-2">各维度得分率平衡度分析</p>
            <div class="w-full max-w-[280px] aspect-square flex items-center justify-center">
              <svg id="radar-svg" viewBox="0 0 300 280" class="w-full h-full overflow-visible"></svg>
            </div>
          </div>
        </div>

        <!-- Personalized Diagnosis & Actionable Suggestions -->
        <div class="bg-white rounded-2xl p-5 sm:p-6 border border-morandi-100 space-y-4">
          <div class="flex items-center gap-2 text-morandi-800 font-bold text-base">
            <i data-lucide="compass" class="w-5 h-5 text-morandi-600"></i>
            <h3>专属画像诊断与提升建议</h3>
          </div>
          <p id="rep-diagnosis-summary" class="text-sm text-morandi-700 leading-relaxed"></p>
          
          <div class="bg-morandi-50/80 rounded-xl p-4 border border-morandi-100 space-y-2">
            <div class="text-xs font-bold text-morandi-800 flex items-center gap-1.5">
              <i data-lucide="lightbulb" class="w-4 h-4 text-amber-500"></i>
              <span id="rep-weakness-title">重点行动指南：</span>
            </div>
            <ul id="rep-action-list" class="text-xs sm:text-sm text-morandi-700 space-y-1.5 list-disc list-inside"></ul>
          </div>
        </div>

        <!-- Report Footer Actions -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
          <p class="text-xs text-morandi-400">提示：可直接手机截屏保存本诊断报告，或点击右侧生成分享图片</p>
          <button onclick="downloadReportImage()" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-white bg-morandi-600 hover:bg-morandi-700 shadow-sm transition">
            <i data-lucide="download" class="w-4 h-4"></i>
            <span>保存结果卡片图片</span>
          </button>
        </div>
      </div>
    </section>

    <!-- ==================== VIEW 3: ORGANIZER ADMIN DASHBOARD ==================== -->
    <section id="view-admin" class="hidden fade-in space-y-6 pb-12">
      <!-- Admin Header -->
      <div class="bg-warmwhite rounded-3xl p-6 shadow-soft border border-morandi-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-morandi-100 text-morandi-700 text-xs font-medium mb-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>云端实时同步中</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-morandi-900">团队测评数据汇总看板</h2>
          <p class="text-xs text-morandi-500 mt-0.5">所有参与者扫码提交的测评结果将自动汇总于此</p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button onclick="openQrModal()" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-morandi-100 text-morandi-800 hover:bg-morandi-200 transition">
            <i data-lucide="qr-code" class="w-4 h-4"></i>
            <span>邀请扫码</span>
          </button>
          <button onclick="exportCSV()" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-morandi-600 text-white hover:bg-morandi-700 shadow-sm transition">
            <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
            <span>导出 Excel/CSV</span>
          </button>
          <button onclick="confirmClearData()" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold bg-rose-50 text-rose-600 border border-rose-200 hover:bg-rose-100 transition">
            <i data-lucide="trash-2" class="w-4 h-4"></i>
            <span>清空数据</span>
          </button>
        </div>
      </div>

      <!-- KPI Overview Cards -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-5 border border-morandi-100 shadow-card">
          <div class="text-xs font-medium text-morandi-500 mb-1">累计参与人数</div>
          <div class="flex items-baseline gap-1.5">
            <span id="stat-total-count" class="text-3xl font-extrabold text-morandi-900">0</span>
