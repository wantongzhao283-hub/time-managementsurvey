  <!-- Firebase SDK & Application Logic -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import { getFirestore, collection, addDoc, onSnapshot, deleteDoc, doc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    // ==================== 1. TMBS 28-ITEM SCALE DATA ====================
    const DIMENSIONS = [
      {
        id: 1,
        name: "维度一：目标与优先级设定",
        en: "Setting Goals and Priorities",
        maxScore: 50,
        desc: "评估设定短期与长期目标、拆解任务及按优先级聚焦核心事项的能力"
      },
      {
        id: 2,
        name: "维度二：计划与日程执行技巧",
        en: "Mechanics: Scheduling & Planning",
        maxScore: 55,
        desc: "评估使用日程工具、列待办清单、利用碎片时间及防干扰的执行习惯"
      },
      {
        id: 3,
        name: "维度三：条理性与环境偏好",
        en: "Preference for Organization",
        maxScore: 35,
        desc: "评估工作/学习环境的整洁度、任务条理性及对计划性的内在偏好"
      }
    ];

    const QUESTIONS = [
      // Dimension 1: Setting Goals and Priorities (10 items, all forward scored)
      { id: 1, dim: 1, reverse: false, zh: "我会评估并回顾每日的日程安排", en: "Evaluates daily schedule" },
      { id: 2, dim: 1, reverse: false, zh: "我会定期复盘自己的各项活动", en: "Reviews activities" },
      { id: 3, dim: 1, reverse: false, zh: "我会为任务设定明确的截止期限", en: "Sets deadlines" },
      { id: 4, dim: 1, reverse: false, zh: "我会主动寻找方法提高任务执行效率", en: "Increases task efficiency" },
      { id: 5, dim: 1, reverse: false, zh: "我会根据重要程度设定任务优先级", en: "Sets priorities" },
      { id: 6, dim: 1, reverse: false, zh: "我会把复杂的大任务拆解成小步骤", en: "Breaks down tasks" },
      { id: 7, dim: 1, reverse: false, zh: "我会制定清晰的短期目标", en: "Sets short-term goals" },
      { id: 8, dim: 1, reverse: false, zh: "我会定期检查自己的目标进展", en: "Reviews goals" },
      { id: 9, dim: 1, reverse: false, zh: "我会优先完成最重要的核心任务", en: "Completes priority tasks" },
      { id: 10, dim: 1, reverse: false, zh: "我会保持对长期目标的专注与规划", en: "Keeps long-term goals" },

      // Dimension 2: Mechanics: Scheduling & Planning (11 items, all forward scored)
      { id: 11, dim: 2, reverse: false, zh: "我有随身携带日程本或使用电子日历的习惯", en: "Carries appointment book" },
      { id: 12, dim: 2, reverse: false, zh: "我会列出待办事项清单", en: "Makes list of things to do" },
      { id: 13, dim: 2, reverse: false, zh: "我会写备忘便签来提醒自己", en: "Writes reminder notes" },
      { id: 14, dim: 2, reverse: false, zh: "我会有效利用等待或碎片化时间", en: "Uses waiting time" },
      { id: 15, dim: 2, reverse: false, zh: "我有做记录与归档的习惯", en: "Practices recordkeeping" },
      { id: 16, dim: 2, reverse: false, zh: "我会随身携带笔记本随时记录想法", en: "Carries notebook" },
      { id: 17, dim: 2, reverse: false, zh: "我会采取措施避免外界打断和干扰", en: "Avoids interruptions" },
      { id: 18, dim: 2, reverse: false, zh: "我会按周提前规划日程与活动", en: "Schedules events weekly" },
      { id: 19, dim: 2, reverse: false, zh: "我会记录每日时间日志或工作日志", en: "Keeps daily log" },
      { id: 20, dim: 2, reverse: false, zh: "我会每天固定规划时间安排", en: "Schedules time daily" },
      { id: 21, dim: 2, reverse: false, zh: "我会定期整理文件与资料", en: "Organizes paperwork" },

      // Dimension 3: Preference for Organization (7 items: first 6 reverse scored, 28th forward scored)
      { id: 22, dim: 3, reverse: true, zh: "我经常感到做事缺乏条理、比较混乱", en: "Is disorganized" },
      { id: 23, dim: 3, reverse: true, zh: "我的工作或学习桌面经常比较凌乱", en: "Has messy work space" },
      { id: 24, dim: 3, reverse: true, zh: "我习惯凭个人喜好（而非重要性）来安排任务顺序", en: "Organizes tasks by preference" },
      { id: 25, dim: 3, reverse: true, zh: "我经常忘记自己写下的待办清单", en: "Forgets lists made" },
      { id: 26, dim: 3, reverse: true, zh: "我认为每天的变化太多，根本无法提前做计划", en: "Believes days to be too unpredictable" },
      { id: 27, dim: 3, reverse: true, zh: "我经常会在无意中浪费很多时间", en: "Schedules wasted time" },
      { id: 28, dim: 3, reverse: false, zh: "我习惯在结束工作/学习后保持桌面整洁", en: "Leaves clean work space" }
    ];

    const LIKERT_OPTIONS = [
      { val: 1, label: "非常不符合" },
      { val: 2, label: "不太符合" },
      { val: 3, label: "一般" },
      { val: 4, label: "比较符合" },
      { val: 5, label: "非常符合" }
    ];

    // ==================== 2. APPLICATION STATE ====================
    let answers = {}; // { questionId: rawScore (1..5) }
    let questionMode = 'step'; // 'step' | 'all'
    let activeStep = 0; // 0, 1, 2
    let highlightedUnanswered = new Set();
    let latestReport = null;
    let isAdminUnlocked = false;
    let allSubmissions = []; // Real-time synced from Firestore

    // Firebase references
    let db = null;
    let auth = null;
    let currentUser = null;
    const appId = typeof __app_id !== 'undefined' ? __app_id : 'tmbs-assessment-app';

    // ==================== 3. FIREBASE INITIALIZATION & SYNC ====================
    async function initCloudSync() {
      try {
        if (typeof __firebase_config === 'undefined') {
          console.warn("Firebase config not found, running in local fallback mode.");
          return;
        }
        const firebaseConfig = JSON.parse(__firebase_config);
        const app = initializeApp(firebaseConfig);
        db = getFirestore(app);
        auth = getAuth(app);

        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
        currentUser = auth.currentUser;

        // Subscribe to public collection for organizer aggregation (RULE 1 & RULE 2 compliant)
        if (currentUser) {
          const submissionsRef = collection(db, 'artifacts', appId, 'public', 'data', 'tmbs_submissions');
          onSnapshot(submissionsRef, (snapshot) => {
            const list = [];
            snapshot.forEach((docSnap) => {
              list.push({ id: docSnap.id, ...docSnap.data() });
            });
            allSubmissions = list;
            if (isAdminUnlocked) {
              renderAdminDashboard();
            }
          }, (error) => {
            console.error("Firestore sync error:", error);
          });
        }
      } catch (err) {
        console.error("Cloud initialization error:", err);
      }
    }

    // ==================== 4. UI RENDERING: QUESTIONS ====================
    window.renderQuestions = function() {
      const container = document.getElementById('questions-container');
      container.innerHTML = '';

      const dimsToRender = questionMode === 'step' ? [DIMENSIONS[activeStep]] : DIMENSIONS;

      dimsToRender.forEach((dim) => {
        // Dimension Header Card
        const dimHeader = document.createElement('div');
        dimHeader.className = 'bg-morandi-600 text-white rounded-2xl p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-2';
        dimHeader.innerHTML = `
          <div>
            <h3 class="font-bold text-base sm:text-lg">${dim.name}</h3>
            <p class="text-xs text-morandi-100 mt-0.5">${dim.en} · ${dim.desc}</p>
          </div>
          <span class="text-xs bg-white/15 px-3 py-1 rounded-full self-start sm:self-center shrink-0">
            本维度共 ${QUESTIONS.filter(q => q.dim === dim.id).length} 题
          </span>
        `;
        container.appendChild(dimHeader);

        // Question Cards
        const dimQuestions = QUESTIONS.filter(q => q.dim === dim.id);
        dimQuestions.forEach((q) => {
          const selectedVal = answers[q.id];
          const isMissing = highlightedUnanswered.has(q.id) && !selectedVal;

          const card = document.createElement('div');
          card.id = `q-card-${q.id}`;
          card.className = `bg-white rounded-2xl p-4 sm:p-5 border transition-all ${
            isMissing
              ? 'border-rose-400 ring-2 ring-rose-200 bg-rose-50/30'
              : selectedVal
                ? 'border-morandi-200/80 shadow-card'
                : 'border-morandi-100 shadow-card'
          }`;

          const buttonsHtml = LIKERT_OPTIONS.map(opt => {
            const isSelected = selectedVal === opt.val;
            return `
              <button type="button" onclick="selectAnswer(${q.id}, ${opt.val})"
                class="likert-btn flex-1 py-2.5 px-1 sm:px-2 rounded-xl border text-center flex flex-col items-center justify-center gap-0.5 ${
                  isSelected
                    ? 'bg-morandi-600 text-white border-morandi-600 shadow-sm font-bold'
                    : 'bg-morandi-50/60 text-morandi-700 border-morandi-200/70 hover:bg-morandi-100/80'
                }">
