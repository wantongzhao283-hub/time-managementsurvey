    window.copyShareUrl = function() {
      const urlInput = document.getElementById('qr-url-input');
      urlInput.select();
      urlInput.setSelectionRange(0, 99999);
      try {
        document.execCommand('copy');
        showToast('测评链接已复制到剪贴板！', 'success');
      } catch (err) {
        showToast('请手动全选复制输入框中的链接', 'error');
      }
    };

    window.downloadQrPoster = function() {
      const qrCanvas = document.querySelector('#qrcode-canvas-box canvas');
      const qrImg = document.querySelector('#qrcode-canvas-box img');
      if (!qrCanvas && !qrImg) {
        showToast('二维码正在生成中，请稍候', 'error');
        return;
      }

      const poster = document.createElement('canvas');
      poster.width = 640;
      poster.height = 840;
      const ctx = poster.getContext('2d');

      // Morandi Blue Gradient Background
      const grad = ctx.createLinearGradient(0, 0, 640, 840);
      grad.addColorStop(0, '#4A6B82');
      grad.addColorStop(1, '#324857');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, 640, 840);

      // Decorative circles
      ctx.fillStyle = 'rgba(255,255,255,0.06)';
      ctx.beginPath();
      ctx.arc(580, 80, 160, 0, Math.PI * 2);
      ctx.fill();

      // Badge
      ctx.fillStyle = 'rgba(255,255,255,0.16)';
      roundRect(ctx, 180, 75, 280, 38, 19, true, false);
      ctx.fillStyle = '#FFFFFF';
      ctx.font = '600 18px "Noto Sans SC", sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('TMBS 学术量表 · 3分钟自测', 320, 100);

      // Title
      ctx.font = 'bold 42px "Noto Sans SC", sans-serif';
      ctx.fillText('测测你的时间管理能力', 320, 175);

      ctx.font = '22px "Noto Sans SC", sans-serif';
      ctx.fillStyle = '#CAD9E2';
      ctx.fillText('目标设定 · 计划执行 · 条理偏好 三维诊断', 320, 222);

      // White QR Card
      ctx.fillStyle = '#FFFFFF';
      roundRect(ctx, 145, 275, 350, 350, 28, true, false);

      // Draw QR Code inside white card
      const source = qrCanvas || qrImg;
      ctx.drawImage(source, 175, 305, 290, 290);

      // Bottom Call to Action
      ctx.fillStyle = '#FFFFFF';
      ctx.font = 'bold 24px "Noto Sans SC", sans-serif';
      ctx.fillText('微信 / 浏览器扫一扫立即测评', 320, 695);

      ctx.fillStyle = '#A4BECD';
      ctx.font = '18px "Noto Sans SC", sans-serif';
      ctx.fillText('提交后立刻获取能力等级与专属雷达图报告', 320, 735);

      const link = document.createElement('a');
      link.download = '时间管理能力测评_邀请海报.png';
      link.href = poster.toDataURL('image/png');
      link.click();
      showToast('二维码邀请海报已下载！', 'success');
    };

    // ==================== 8. ORGANIZER ADMIN DASHBOARD ====================
    window.handleAdminNav = function() {
      if (isAdminUnlocked) {
        switchView('admin');
        renderAdminDashboard();
      } else {
        const modal = document.getElementById('admin-auth-modal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => document.getElementById('admin-pwd-input').focus(), 100);
      }
    };

    window.closeAdminAuthModal = function() {
      const modal = document.getElementById('admin-auth-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    };

    window.verifyAdminPwd = function() {
      const pwd = document.getElementById('admin-pwd-input').value.trim();
      if (pwd === '1234') {
        isAdminUnlocked = true;
        closeAdminAuthModal();
        switchView('admin');
        renderAdminDashboard();
        showToast('验证成功，已进入组织者汇总看板', 'success');
      } else {
        showToast('密码错误（默认密码为 1234）', 'error');
      }
    };

    window.renderAdminDashboard = function() {
      const count = allSubmissions.length;
      document.getElementById('stat-total-count').textContent = count;

      if (count === 0) {
        document.getElementById('stat-avg-total').textContent = '0.0';
        document.getElementById('stat-avg-mean').textContent = '0.00';
        document.getElementById('stat-top-rate').textContent = '0%';
        document.getElementById('stat-top-count').textContent = '(0人)';
        document.getElementById('tier-dist-bar').innerHTML = `<div class="bg-morandi-200 w-full h-full"></div>`;
        document.getElementById('tier-dist-legend').innerHTML = `<p class="col-span-2 text-morandi-400">暂无数据</p>`;
        document.getElementById('team-d1-text').textContent = '0.0 分 (0%)';
        document.getElementById('team-d1-bar').style.width = '0%';
        document.getElementById('team-d2-text').textContent = '0.0 分 (0%)';
        document.getElementById('team-d2-bar').style.width = '0%';
        document.getElementById('team-d3-text').textContent = '0.0 分 (0%)';
        document.getElementById('team-d3-bar').style.width = '0%';
        renderAdminTable();
        return;
      }

      const sumTotal = allSubmissions.reduce((acc, s) => acc + (s.totalScore || 0), 0);
      const sumD1 = allSubmissions.reduce((acc, s) => acc + (s.d1 || 0), 0);
      const sumD2 = allSubmissions.reduce((acc, s) => acc + (s.d2 || 0), 0);
      const sumD3 = allSubmissions.reduce((acc, s) => acc + (s.d3 || 0), 0);

      const avgTotal = (sumTotal / count).toFixed(1);
      const avgMean = (sumTotal / count / 28).toFixed(2);
      const avgD1 = (sumD1 / count).toFixed(1);
      const avgD2 = (sumD2 / count).toFixed(1);
      const avgD3 = (sumD3 / count).toFixed(1);

      const avgD1Pct = Math.round((sumD1 / count / 50) * 100);
      const avgD2Pct = Math.round((sumD2 / count / 55) * 100);
      const avgD3Pct = Math.round((sumD3 / count / 35) * 100);

      // Tier distribution counts
      const tiers = [
        { name: '卓越掌控型', count: allSubmissions.filter(s => s.tier === '卓越掌控型').length, color: 'bg-morandi-600', dot: 'bg-morandi-600' },
        { name: '稳健进阶型', count: allSubmissions.filter(s => s.tier === '稳健进阶型').length, color: 'bg-morandi-400', dot: 'bg-morandi-400' },
        { name: '随性探索型', count: allSubmissions.filter(s => s.tier === '随性探索型').length, color: 'bg-amber-400', dot: 'bg-amber-400' },
        { name: '亟待破局型', count: allSubmissions.filter(s => s.tier === '亟待破局型').length, color: 'bg-rose-400', dot: 'bg-rose-400' }
      ];

      const topCount = tiers[0].count;
      const topRate = Math.round((topCount / count) * 100);

      document.getElementById('stat-avg-total').textContent = avgTotal;
      document.getElementById('stat-avg-mean').textContent = avgMean;
      document.getElementById('stat-top-rate').textContent = `${topRate}%`;
      document.getElementById('stat-top-count').textContent = `(${topCount}人)`;

      // Render stacked bar & legend
      document.getElementById('tier-dist-bar').innerHTML = tiers.map(t => {
        const w = (t.count / count) * 100;
        return w > 0 ? `<div class="${t.color} h-full transition-all duration-500" style="width: ${w}%" title="${t.name}: ${t.count}人"></div>` : '';
      }).join('');

      document.getElementById('tier-dist-legend').innerHTML = tiers.map(t => {
        const pct = Math.round((t.count / count) * 100);
        return `
          <div class="flex items-center justify-between bg-morandi-50/70 px-3 py-2 rounded-xl">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full ${t.dot}"></span>
              <span class="text-morandi-700 font-medium">${t.name}</span>
            </div>
            <span class="font-bold text-morandi-900">${t.count}人 <span class="text-morandi-400 font-normal">(${pct}%)</span></span>
          </div>
        `;
      }).join('');

      // Team dimension averages
      document.getElementById('team-d1-text').textContent = `${avgD1} 分 (${avgD1Pct}%)`;
      document.getElementById('team-d1-bar').style.width = `${avgD1Pct}%`;

      document.getElementById('team-d2-text').textContent = `${avgD2} 分 (${avgD2Pct}%)`;
      document.getElementById('team-d2-bar').style.width = `${avgD2Pct}%`;

      document.getElementById('team-d3-text').textContent = `${avgD3} 分 (${avgD3Pct}%)`;
      document.getElementById('team-d3-bar').style.width = `${avgD3Pct}%`;

      renderAdminTable();
    };

    window.renderAdminTable = function() {
      const tbody = document.getElementById('admin-table-body');
      const emptyState = document.getElementById('admin-empty-state');
      const keyword = (document.getElementById('admin-search').value || '').trim().toLowerCase();
      const sortMode = document.getElementById('admin-sort').value;

      let filtered = allSubmissions.filter(s => {
        if (!keyword) return true;
        return (s.name && s.name.toLowerCase().includes(keyword)) ||
               (s.group && s.group.toLowerCase().includes(keyword)) ||
               (s.tier && s.tier.toLowerCase().includes(keyword));
      });

      filtered.sort((a, b) => {
        if (sortMode === 'score-desc') return (b.totalScore || 0) - (a.totalScore || 0);
        if (sortMode === 'score-asc') return (a.totalScore || 0) - (b.totalScore || 0);
        return (b.timestamp || 0) - (a.timestamp || 0);
      });

      if (filtered.length === 0) {
        tbody.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');
      tbody.innerHTML = filtered.map(s => {
        const badgeStyle =
          s.tier === '卓越掌控型' ? 'bg-morandi-100 text-morandi-800 border-morandi-300' :
          s.tier === '稳健进阶型' ? 'bg-sky-50 text-sky-700 border-sky-200' :
          s.tier === '随性探索型' ? 'bg-amber-50 text-amber-700 border-amber-200' :
          'bg-rose-50 text-rose-700 border-rose-200';

        return `
          <tr class="hover:bg-morandi-50/60 transition">
            <td class="py-3 px-4 font-semibold text-morandi-900 whitespace-nowrap">${escapeHtml(s.name)}</td>
            <td class="py-3 px-4 text-morandi-500 whitespace-nowrap">${escapeHtml(s.group || '未分组')}</td>
            <td class="py-3 px-4 whitespace-nowrap">
              <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold border ${badgeStyle}">${escapeHtml(s.tier)}</span>
            </td>
            <td class="py-3 px-4 text-right font-bold text-morandi-800 whitespace-nowrap">
              ${s.totalScore} <span class="text-xs font-normal text-morandi-400">(${Number(s.meanScore).toFixed(2)})</span>
            </td>
            <td class="py-3 px-4 text-right text-morandi-600 whitespace-nowrap">${s.d1}/50</td>
            <td class="py-3 px-4 text-right text-morandi-600 whitespace-nowrap">${s.d2}/55</td>
            <td class="py-3 px-4 text-right text-morandi-600 whitespace-nowrap">${s.d3}/35</td>
            <td class="py-3 px-4 text-right text-xs text-morandi-400 whitespace-nowrap">${escapeHtml(s.submittedAt || '')}</td>
          </tr>
        `;
      }).join('');
    };

    window.exportCSV = function() {
      if (allSubmissions.length === 0) {
        showToast('当前没有可导出的测评数据', 'error');
        return;
      }

      const headers = ['姓名/昵称', '组别/学号', '能力等级', '总分(满分140)', '题项均分(1-5)', '目标与优先级设定(满分50)', '计划与日程执行技巧(满分55)', '条理性与环境偏好(满分35)', '提交时间'];
      const rows = allSubmissions.map(s => [
        `"${(s.name || '').replace(/"/g, '""')}"`,
        `"${(s.group || '未分组').replace(/"/g, '""')}"`,
        `"${s.tier}"`,
        s.totalScore,
        s.meanScore,
        s.d1,
        s.d2,
        s.d3,
        `"${s.submittedAt || ''}"`
      ]);

      // Add UTF-8 BOM (\uFEFF) to prevent Chinese garbled text in Excel
      const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `时间管理能力测评汇总表_${formatDateFile(new Date())}.csv`;
      link.click();
      URL.revokeObjectURL(url);
      showToast(`已成功导出 ${allSubmissions.length} 条测评数据！`, 'success');
    };

    window.confirmClearData = function() {
      if (allSubmissions.length === 0) {
        showToast('当前暂无数据可清空', 'error');
        return;
      }
      const modal = document.getElementById('confirm-clear-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    };

    window.closeClearModal = function() {
      const modal = document.getElementById('confirm-clear-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    };

    window.executeClearData = async function() {
      closeClearModal();
      try {
        if (db && currentUser) {
          const promises = allSubmissions.map(item =>
            deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'tmbs_submissions', item.id))
          );
          await Promise.all(promises);
        }
        allSubmissions = [];
        renderAdminDashboard();
        showToast('已清空所有测评记录', 'success');
      } catch (err) {
        console.error('Clear data error:', err);
        showToast('清空数据失败，请稍后重试', 'error');
      }
    };

    // ==================== 9. NAVIGATION & HELPERS ====================
    window.switchView = function(viewName) {
      ['assessment', 'report', 'admin'].forEach(v => {
        const el = document.getElementById(`view-${v}`);
        if (v === viewName) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
      lucide.createIcons();
    };

    window.showToast = function(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const style = type === 'error'
        ? 'bg-rose-600 text-white shadow-lg'
        : type === 'success'
          ? 'bg-morandi-700 text-white shadow-lg'
          : 'bg-morandi-800 text-white shadow-lg';

      toast.className = `${style} px-4 py-3 rounded-2xl text-xs sm:text-sm font-medium flex items-center justify-center gap-2 fade-in`;
      toast.textContent = message;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transition = 'opacity 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 2800);
    };

    function formatDateTime(date) {
      const pad = n => String(n).padStart(2, '0');
      return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`;
    }

    function formatDateFile(date) {
      const pad = n => String(n).padStart(2, '0');
      return `${date.getFullYear()}${pad(date.getMonth() + 1)}${pad(date.getDate())}`;
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function roundRect(ctx, x, y, width, height, radius, fill, stroke) {
      ctx.beginPath();
      ctx.moveTo(x + radius, y);
      ctx.lineTo(x + width - radius, y);
      ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
      ctx.lineTo(x + width, y + height - radius);
      ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
      ctx.lineTo(x + radius, y + height);
      ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
      ctx.lineTo(x, y + radius);
      ctx.quadraticCurveTo(x, y, x + radius, y);
      ctx.closePath();
      if (fill) ctx.fill();
      if (stroke) ctx.stroke();
    }

    // Boot Application
    window.addEventListener('DOMContentLoaded', () => {
      renderQuestions();
      setActiveStep(0);
      lucide.createIcons();
      initCloudSync();
    });
  </script>
