    function drawRadarSVG(p1, p2, p3) {
      const svg = document.getElementById('radar-svg');
      const cx = 150, cy = 148, maxR = 92;
      // 3 angles: Top (-90deg), Bottom-Right (30deg), Bottom-Left (150deg)
      const angles = [-Math.PI / 2, Math.PI / 6, (5 * Math.PI) / 6];

      const getPoint = (radius, angle) => ({
        x: cx + radius * Math.cos(angle),
        y: cy + radius * Math.sin(angle)
      });

      // Concentric web levels (25%, 50%, 75%, 100%)
      let webHtml = '';
      [0.25, 0.5, 0.75, 1.0].forEach(level => {
        const pts = angles.map(a => {
          const p = getPoint(maxR * level, a);
          return `${p.x.toFixed(1)},${p.y.toFixed(1)}`;
        }).join(' ');
        webHtml += `<polygon points="${pts}" fill="${level === 1 ? '#F4F7F9' : 'none'}" stroke="#CAD9E2" stroke-width="1" stroke-dasharray="${level === 1 ? 'none' : '3,3'}" />`;
      });

      // Axis lines
      let axisHtml = '';
      angles.forEach(a => {
        const p = getPoint(maxR, a);
        axisHtml += `<line x1="${cx}" y1="${cy}" x2="${p.x.toFixed(1)}" y2="${p.y.toFixed(1)}" stroke="#CAD9E2" stroke-width="1.2" />`;
      });

      // Data polygon
      const vals = [p1 / 100, p2 / 100, p3 / 100];
      const dataPoints = vals.map((v, idx) => getPoint(maxR * Math.max(v, 0.08), angles[idx]));
      const polyStr = dataPoints.map(p => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');

      const dotsHtml = dataPoints.map(p => `
        <circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="4.5" fill="#4A6B82" stroke="#FFFFFF" stroke-width="2" />
      `).join('');

      svg.innerHTML = `
        ${webHtml}
        ${axisHtml}
        <polygon points="${polyStr}" fill="rgba(74, 107, 130, 0.28)" stroke="#4A6B82" stroke-width="2.5" stroke-linejoin="round" />
        ${dotsHtml}
        <!-- Labels -->
        <text x="150" y="26" text-anchor="middle" fill="#2B3C49" font-size="11" font-weight="700">目标与优先级</text>
        <text x="150" y="40" text-anchor="middle" fill="#4A6B82" font-size="11" font-weight="700">${p1}%</text>

        <text x="248" y="212" text-anchor="middle" fill="#2B3C49" font-size="11" font-weight="700">计划与执行</text>
        <text x="248" y="226" text-anchor="middle" fill="#6B8E9B" font-size="11" font-weight="700">${p2}%</text>

        <text x="52" y="212" text-anchor="middle" fill="#2B3C49" font-size="11" font-weight="700">条理与环境</text>
        <text x="52" y="226" text-anchor="middle" fill="#0D9488" font-size="11" font-weight="700">${p3}%</text>
      `;
    }

