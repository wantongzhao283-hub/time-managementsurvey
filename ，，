    window.selectAnswer = function(qId, val) {
      answers[qId] = val;
      highlightedUnanswered.delete(qId);
      renderQuestions();
    };

    window.setQuestionMode = function(mode) {
      questionMode = mode;
      const stepBtn = document.getElementById('mode-step-btn');
      const allBtn = document.getElementById('mode-all-btn');
      const dimTabs = document.getElementById('dimension-tabs');
      const stepNav = document.getElementById('step-nav-buttons');

      if (mode === 'step') {
        stepBtn.className = 'px-3 py-1 rounded-lg font-medium bg-white text-morandi-800 shadow-sm transition';
        allBtn.className = 'px-3 py-1 rounded-lg font-medium text-morandi-600 hover:text-morandi-900 transition';
        dimTabs.classList.remove('hidden');
        stepNav.classList.remove('hidden');
      } else {
        allBtn.className = 'px-3 py-1 rounded-lg font-medium bg-white text-morandi-800 shadow-sm transition';
        stepBtn.className = 'px-3 py-1 rounded-lg font-medium text-morandi-600 hover:text-morandi-900 transition';
        dimTabs.classList.add('hidden');
        stepNav.classList.add('hidden');
      }
      renderQuestions();
    };

    window.setActiveStep = function(stepIdx) {
      activeStep = stepIdx;
      for (let i = 0; i < 3; i++) {
        const tab = document.getElementById(`step-tab-${i}`);
        if (i === activeStep) {
          tab.className = 'py-2 px-2 rounded-xl text-xs font-semibold border transition flex flex-col sm:flex-row items-center justify-center gap-1 bg-morandi-600 text-white border-morandi-600 shadow-sm';
        } else {
          tab.className = 'py-2 px-2 rounded-xl text-xs font-semibold border transition flex flex-col sm:flex-row items-center justify-center gap-1 bg-white text-morandi-600 border-morandi-200 hover:bg-morandi-100/50';
        }
      }
      document.getElementById('prev-step-btn').disabled = (activeStep === 0);
      const nextBtn = document.getElementById('next-step-btn');
      if (activeStep === 2) {
        nextBtn.classList.add('hidden');
      } else {
        nextBtn.classList.remove('hidden');
      }
      renderQuestions();
      window.scrollTo({ top: 180, behavior: 'smooth' });
    };

    window.changeStep = function(delta) {
      const next = activeStep + delta;
      if (next >= 0 && next <= 2) {
        setActiveStep(next);
      }
    };

    function updateProgressUI() {
      const answeredCount = Object.keys(answers).length;
      const pct = Math.round((answeredCount / 28) * 100);
      document.getElementById('progress-text').textContent = `${answeredCount} / 28 题`;
      document.getElementById('progress-bar').style.width = `${pct}%`;

      // Update per-dimension counts
      const d1Count = QUESTIONS.filter(q => q.dim === 1 && answers[q.id]).length;
      const d2Count = QUESTIONS.filter(q => q.dim === 2 && answers[q.id]).length;
      const d3Count = QUESTIONS.filter(q => q.dim === 3 && answers[q.id]).length;
      document.getElementById('step-count-0').textContent = `(${d1Count}/10)`;
      document.getElementById('step-count-1').textContent = `(${d2Count}/11)`;
      document.getElementById('step-count-2').textContent = `(${d3Count}/7)`;
    }

    // ==================== 5. SCORING & SUBMISSION LOGIC ====================
    window.submitAssessment = async function() {
      const nameInput = document.getElementById('input-name');
      const groupInput = document.getElementById('input-group');
      const name = nameInput.value.trim();
      const group = groupInput.value.trim();

      if (!name) {
        showToast('请先填写您的姓名或昵称，方便生成专属报告！', 'error');
        nameInput.focus();
        nameInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      // Check for unanswered questions
      const missing = QUESTIONS.filter(q => !answers[q.id]);
      if (missing.length > 0) {
        missing.forEach(q => highlightedUnanswered.add(q.id));
        const firstMissing = missing[0];
        if (questionMode === 'step') {
          setActiveStep(firstMissing.dim - 1);
        } else {
          renderQuestions();
        }
        showToast(`还有 ${missing.length} 道题未完成，已为您标红提示！`, 'error');
        setTimeout(() => {
          const el = document.getElementById(`q-card-${firstMissing.id}`);
          if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 100);
        return;
      }

      // Calculate dimension scores (with reverse scoring 6 - raw for reverse items)
      let d1 = 0, d2 = 0, d3 = 0;
      QUESTIONS.forEach(q => {
        const raw = answers[q.id];
        const effectiveScore = q.reverse ? (6 - raw) : raw;
        if (q.dim === 1) d1 += effectiveScore;
        if (q.dim === 2) d2 += effectiveScore;
        if (q.dim === 3) d3 += effectiveScore;
      });

      const totalScore = d1 + d2 + d3; // Max 140
      const meanScore = Number((totalScore / 28).toFixed(2));
      const d1Pct = Math.round((d1 / 50) * 100);
      const d2Pct = Math.round((d2 / 55) * 100);
      const d3Pct = Math.round((d3 / 35) * 100);

      // Determine Tier
      const tierInfo = evaluateTier(totalScore, meanScore, { d1Pct, d2Pct, d3Pct });

      const reportRecord = {
        name,
        group: group || '未分组',
        d1,
        d2,
        d3,
        d1Pct,
        d2Pct,
        d3Pct,
        totalScore,
        meanScore,
        tier: tierInfo.title,
        timestamp: Date.now(),
        submittedAt: formatDateTime(new Date())
      };

      latestReport = reportRecord;
      renderReportView(reportRecord, tierInfo);
      document.getElementById('nav-report-btn').classList.remove('hidden');
      document.getElementById('nav-report-btn').classList.add('flex');
      switchView('report');

      // Save to Cloud Firestore
      const syncBadge = document.getElementById('sync-badge');
      try {
        if (db && currentUser) {
          const submissionsRef = collection(db, 'artifacts', appId, 'public', 'data', 'tmbs_submissions');
          await addDoc(submissionsRef, reportRecord);
          syncBadge.innerHTML = `<i data-lucide="cloud-check" class="w-3.5 h-3.5"></i><span>结果已实时汇总至组织者后台</span>`;
          syncBadge.className = 'inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200';
        } else {
          allSubmissions.push({ id: 'local-' + Date.now(), ...reportRecord });
          syncBadge.innerHTML = `<i data-lucide="check-circle" class="w-3.5 h-3.5"></i><span>本地模式已保存</span>`;
        }
        lucide.createIcons();
        showToast('测评提交成功！已为您生成诊断报告', 'success');
      } catch (err) {
        console.error("Failed to save submission:", err);
        showToast('报告已生成，但云端同步遇到网络波动', 'error');
      }
    };

